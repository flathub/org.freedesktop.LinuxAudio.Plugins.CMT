{
    "id": "org.freedesktop.LinuxAudio.Plugins.CMT",
    "branch": "25.08",
    "runtime": "org.freedesktop.LinuxAudio.BaseExtension",
    "runtime-version": "stable",
    "sdk": "org.freedesktop.Sdk//25.08",
    "build-extension": true,
    "build-options": {
        "prefix": "/app/extensions/Plugins/CMT"
    },
    "modules": [
        {
            "name": "cmt",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir ../plugins",
                "make",
                "make install",
                "install -Dm644 -t ${FLATPAK_DEST}/share/metainfo ../org.freedesktop.LinuxAudio.Plugins.CMT.metainfo.xml",
                "install -Dm644 -t $FLATPAK_DEST/share/licenses/cmt/ ../doc/COPYING"
            ],
            "subdir": "src",
            "sources": [
                {
                    "type": "git",
                    "url": "https://salsa.debian.org/multimedia-team/cmt.git",
                    "commit": "0b79790da79cec4dd1e5c824b59faddac6b2164a"
                },
                {
                    "type": "patch",
                    "path": "build-fixes.patch"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.LinuxAudio.Plugins.CMT.metainfo.xml"
                }
            ]
        }
    ]
}
